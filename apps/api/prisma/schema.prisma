model ImpactItem {
  id           String    @id @default(uuid())
  amount       Int
  labelEn      String
  labelHi      String?
  outcomeEn    String
  outcomeHi    String?
  descEn       String?
  descHi       String?
  iconName     String?
  linkedSevaId String?
  sortOrder    Int       @default(0)
  active       Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("impact_items")
}

model DonorBenefit {
  id        String    @id @default(uuid())
  titleEn   String
  titleHi   String?
  descEn    String
  descHi    String?
  iconName  String?
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("donor_benefits")
}

model GalleryItem {
  id        String    @id @default(uuid())
  imageUrl  String
  captionEn String?
  captionHi String?
  category  String    @default("Heritage")
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("gallery_items")
}

model InvolveCard {
  id           String    @id @default(uuid())
  titleEn      String
  titleHi      String?
  descEn       String
  descHi       String?
  actionLabelEn String?
  actionLabelHi String?
  actionTarget String?
  iconName     String?
  isFeatured   Boolean   @default(false)
  sortOrder    Int       @default(0)
  active       Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("involve_cards")
}

model FaqItem {
  id         String    @id @default(uuid())
  questionEn String
  questionHi String?
  answerEn   String
  answerHi   String?
  category   String    @default("General")
  sortOrder  Int       @default(0)
  active     Boolean   @default(true)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("faq_items")
}

model PledgeContent {
  id              String   @id @default("singleton")
  shlokaSanskrit  String
  transliteration String?
  meaningEn       String
  meaningHi       String?
  textEn          String?
  textHi          String?
  source          String?  @default("Brihadaranyaka Upanishad")
  updatedAt       DateTime @updatedAt

  @@map("pledge_content")
}

model PolicyPage {
  id        String    @id @default(uuid())
  slug      String    @unique
  titleEn   String
  titleHi   String?
  contentEn String
  contentHi String?
  deletedAt DateTime?
  updatedAt DateTime  @updatedAt
  createdAt DateTime  @default(now())

  @@map("policy_pages")
}

model Announcement {
  id          String    @id @default(uuid())
  titleEn     String
  titleHi     String?
  textEn      String
  textHi      String?
  linkLabelEn String?
  linkLabelHi String?
  linkUrl     String?
  startsAt    DateTime?
  endsAt      DateTime?
  dismissible Boolean   @default(true)
  active      Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("announcements")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  interest  String?
  message   String
  status    String   @default("NEW") // NEW, READ, REPLIED, ARCHIVED
  notes     String?
  ipHash    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("contact_messages")
}

model VolunteerApplication {
  id           String   @id @default(uuid())
  name         String
  phone        String
  email        String
  city         String?
  skills       String?
  availability String?
  message      String?
  status       String   @default("NEW") // NEW, REVIEWING, ACCEPTED, ARCHIVED
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
  @@map("volunteer_applications")
}

// ----------------------------------------------------
// Media Management System Models
// ----------------------------------------------------

model MediaAsset {
  id           String       @id @default(uuid())
  kind         String       @default("IMAGE") // IMAGE, DOCUMENT
  originalName String
  mime         String
  sizeBytes    Int
  width        Int?
  height       Int?
  blurDataUrl  String?
  storageKey   String
  url          String
  variants     Json?
  alt          String?
  caption      String?
  status       String       @default("ATTACHED") // TEMP, ATTACHED, TRASHED
  uploadedById String?
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  usages       MediaUsage[]

  @@index([status, deletedAt])
  @@map("media_assets")
}

model MediaUsage {
  id         String     @id @default(uuid())
  assetId    String
  entityType String
  entityId   String
  field      String
  createdAt  DateTime   @default(now())
  asset      MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([entityType, entityId])
  @@map("media_usages")
}
