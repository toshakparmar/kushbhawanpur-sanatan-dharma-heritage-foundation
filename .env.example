# ==============================================================================
# Kushbhawanpur Foundation — Environment Configuration (.env.example)
# ==============================================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/kushbhawanpur_foundation?schema=public"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres123"
POSTGRES_DB="kushbhawanpur_foundation"
POSTGRES_PORT=5432

# Backend API Configuration
PORT=4000
NODE_ENV="development"
API_URL="http://localhost:4000"
CORS_ORIGINS="http://localhost:3000,https://kushbhawanpur-sanatan-dharma-herita.vercel.app"

# Security & Cryptography
# Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-very-secure-random-jwt-secret-key-32-chars-min"
JWT_EXPIRES_IN="7d"
# 32-byte hexadecimal string for AES-256-GCM encryption of sensitive data (PAN, account numbers)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Initial Super Admin Seed Credentials (forced password change on first login)
ADMIN_EMAIL="admin@kushbhawanpur.org"
ADMIN_INITIAL_PASSWORD="Admin@Kushbhawanpur2026"

# File Storage Configuration
# Options: "local" (default for dev), "cloudinary", "s3"
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"

# Cloudinary (Optional if STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Cloudflare R2 / AWS S3 (Optional if STORAGE_DRIVER=s3)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET_NAME=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Transactional Email (SMTP or Resend)
MAIL_DRIVER="smtp" # or "resend"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM_NAME="Kushbhawanpur Sanatan Dharma Foundation"
MAIL_FROM_ADDRESS="no-reply@kushbhawanpur.org"
RESEND_API_KEY=""

# On-demand Public ISR Cache Revalidation
REVALIDATE_SECRET="replace-with-shared-secret-between-api-and-web"

# Public Web Application
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Anti-Bot & Spam (Optional)
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Video Embed Security Allowlist
ALLOWED_VIDEO_DOMAINS="youtube.com,youtu.be,youtube-nocookie.com,vimeo.com,facebook.com,fb.watch,drive.google.com"

# Optional Demo Seed (Dev only)
SEED_DEMO="false"
