{
  "name": "kushbhawanpur-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@kushbhawanpur/web",
    "dev:api": "npm run start:dev --workspace=@kushbhawanpur/api",
    "dev": "npm run dev --workspace=@kushbhawanpur/web",
    "build:shared": "npm run build --workspace=@kushbhawanpur/shared",
    "build:web": "npm run build --workspace=@kushbhawanpur/web",
    "build:api": "npm run build --workspace=@kushbhawanpur/api",
    "build": "npm run build --workspaces --if-present",
    "db:migrate": "npm run prisma:migrate --workspace=@kushbhawanpur/api",
    "db:seed": "npm run prisma:seed --workspace=@kushbhawanpur/api",
    "lint": "npm run lint --workspaces --if-present"
  }
}
